# ==============================================================================
# GlobalLogger Configuration
# ==============================================================================
#
# This file contains all environment variables for the GlobalLogger package.
# Copy the variables you need to your application's .env file.
#
# Default Provider: Custom (File-based) - No external dependencies required
# ==============================================================================

# ------------------------------------------------------------------------------
# Request ID Configuration
# ------------------------------------------------------------------------------
# Generate unique IDs for request correlation across all logs

GLOBALLOG_INCLUDE_REQUEST_ID_IN_RESPONSE=true

# ------------------------------------------------------------------------------
# Automatic Tracing
# ------------------------------------------------------------------------------
# Automatically trace common Laravel operations (HTTP, DB, Queue, Mail, Cache)

GLOBALLOG_AUTO_TRACING_ENABLED=true
GLOBALLOG_AUTO_TRACE_HTTP=true
GLOBALLOG_AUTO_TRACE_DATABASE=true
GLOBALLOG_AUTO_TRACE_QUEUE=true
GLOBALLOG_AUTO_TRACE_MAIL=true
GLOBALLOG_AUTO_TRACE_CACHE=false
GLOBALLOG_AUTO_TRACE_MIN_DURATION=10

# ------------------------------------------------------------------------------
# Log Providers
# ------------------------------------------------------------------------------
# Enable/disable different logging destinations
# DEFAULT: Custom (file-based) - Works out of the box, no configuration needed

# Custom File Logging (RECOMMENDED DEFAULT - No setup required)
GLOBALLOG_CUSTOM_ENABLED=true
GLOBALLOG_CUSTOM_PATH=storage/logs/globallogger.log
GLOBALLOG_CUSTOM_MAX_FILES=14

# Database Logging (Requires migration: php artisan migrate)
GLOBALLOG_DATABASE_ENABLED=false
GLOBALLOG_DB_CONNECTION=mysql
GLOBALLOG_DB_TABLE=global_logs

# AWS CloudWatch + X-Ray (Requires aws/aws-sdk-php package)
GLOBALLOG_AWS_ENABLED=false
AWS_DEFAULT_REGION=us-east-1
GLOBALLOG_AWS_LOG_GROUP=/aws/laravel
GLOBALLOG_AWS_LOG_STREAM=application
GLOBALLOG_XRAY_ENABLED=true
XRAY_DAEMON_ADDRESS=127.0.0.1:2000

# Datadog (Requires datadog/php-datadogstatsd package)
GLOBALLOG_DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_HOST=http-intake.logs.datadoghq.com
DATADOG_SERVICE=laravel
DATADOG_APM_ENABLED=true
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126

# Oracle Cloud Logging (Requires oci8 extension)
GLOBALLOG_ORACLE_ENABLED=false
ORACLE_LOGGING_ENDPOINT=
ORACLE_LOG_ID=
ORACLE_COMPARTMENT_ID=
ORACLE_TENANCY_ID=
ORACLE_USER_ID=
ORACLE_KEY_FINGERPRINT=
ORACLE_PRIVATE_KEY_PATH=

# ------------------------------------------------------------------------------
# Privacy & GDPR Compliance
# ------------------------------------------------------------------------------
# Automatic PII redaction for GDPR, CCPA, and privacy regulations

GLOBALLOG_REDACT_PII=true
GLOBALLOG_LOG_USER_ID=true
GLOBALLOG_LOG_IP_ADDRESS=true
GLOBALLOG_LOG_USER_AGENT=true
GLOBALLOG_ANONYMIZE_IP=false

# ------------------------------------------------------------------------------
# Performance Configuration
# ------------------------------------------------------------------------------

# Batch Logging (Reduces database operations by 99%)
GLOBALLOG_BATCH_ENABLED=true
GLOBALLOG_BATCH_SIZE=100
GLOBALLOG_BATCH_FLUSH_INTERVAL=5

# Async Queue-Based Logging (Requires queue worker)
GLOBALLOG_ASYNC_ENABLED=false
GLOBALLOG_ASYNC_QUEUE=logs
GLOBALLOG_ASYNC_CONNECTION=

# Log Sampling (Reduce volume for high-traffic applications)
GLOBALLOG_SAMPLING_ENABLED=false
GLOBALLOG_SAMPLING_RATE=0.1

# Circuit Breaker (Prevent cascading failures)
GLOBALLOG_CIRCUIT_BREAKER_ENABLED=true
GLOBALLOG_CIRCUIT_BREAKER_THRESHOLD=5
GLOBALLOG_CIRCUIT_BREAKER_TIMEOUT=60
GLOBALLOG_CIRCUIT_BREAKER_HALF_OPEN=1

# ------------------------------------------------------------------------------
# Provider Log Level Filtering
# ------------------------------------------------------------------------------
# Control minimum log level per provider (debug, info, notice, warning, error, critical, alert, emergency)

GLOBALLOG_AWS_MIN_LEVEL=debug
GLOBALLOG_DATADOG_MIN_LEVEL=debug
GLOBALLOG_ORACLE_MIN_LEVEL=debug
GLOBALLOG_DATABASE_MIN_LEVEL=info
GLOBALLOG_CUSTOM_MIN_LEVEL=debug

# ------------------------------------------------------------------------------
# Log Retention
# ------------------------------------------------------------------------------
# Automatic cleanup of old logs (run: php artisan globallogger:prune)

GLOBALLOG_RETENTION_ENABLED=true
GLOBALLOG_RETENTION_DAYS=30
GLOBALLOG_CLEANUP_ON_DEPLOY=false

# ------------------------------------------------------------------------------
# Exception Handling
# ------------------------------------------------------------------------------

GLOBALLOG_AUTO_LOG_EXCEPTIONS=true
GLOBALLOG_EXCEPTION_INCLUDE_TRACE=true

# ------------------------------------------------------------------------------
# Laravel Feature Monitoring
# ------------------------------------------------------------------------------

# Jobs & Queues
GLOBALLOG_JOBS_ENABLED=true
GLOBALLOG_JOBS_INCLUDE_PAYLOAD=false

# Cache Operations
GLOBALLOG_CACHE_ENABLED=true
GLOBALLOG_CACHE_LOG_HITS=false
GLOBALLOG_CACHE_LOG_MISSES=true
GLOBALLOG_CACHE_LOG_WRITES=false
GLOBALLOG_CACHE_LOG_DELETIONS=false

# Database Queries
GLOBALLOG_DATABASE_MONITORING_ENABLED=true
GLOBALLOG_DATABASE_LOG_ALL_QUERIES=false
GLOBALLOG_SLOW_QUERY_THRESHOLD=100
GLOBALLOG_DATABASE_INCLUDE_BINDINGS=false
GLOBALLOG_DATABASE_LOG_CONNECTIONS=false

# HTTP Requests
GLOBALLOG_HTTP_ENABLED=true
GLOBALLOG_SLOW_REQUEST_THRESHOLD=1000
GLOBALLOG_HTTP_INCLUDE_QUERY=false
GLOBALLOG_HTTP_INCLUDE_BODY=false

# Scheduled Tasks
GLOBALLOG_SCHEDULER_ENABLED=true

# Mail
GLOBALLOG_MAIL_ENABLED=true
GLOBALLOG_MAIL_LOG_SENDING=false

# ==============================================================================
# Configuration Presets
# ==============================================================================
#
# Copy one of these presets to your .env file for quick setup
# ==============================================================================

# ------------------------------------------------------------------------------
# PRESET 1: Development (File-based, Maximum detail)
# ------------------------------------------------------------------------------
# GLOBALLOG_CUSTOM_ENABLED=true
# GLOBALLOG_CUSTOM_MIN_LEVEL=debug
# GLOBALLOG_REDACT_PII=false
# GLOBALLOG_DATABASE_LOG_ALL_QUERIES=true
# GLOBALLOG_SAMPLING_ENABLED=false

# ------------------------------------------------------------------------------
# PRESET 2: Production (Database + File, Privacy enabled)
# ------------------------------------------------------------------------------
# GLOBALLOG_DATABASE_ENABLED=true
# GLOBALLOG_DATABASE_MIN_LEVEL=info
# GLOBALLOG_CUSTOM_ENABLED=true
# GLOBALLOG_CUSTOM_MIN_LEVEL=error
# GLOBALLOG_REDACT_PII=true
# GLOBALLOG_ANONYMIZE_IP=true
# GLOBALLOG_BATCH_ENABLED=true
# GLOBALLOG_CIRCUIT_BREAKER_ENABLED=true

# ------------------------------------------------------------------------------
# PRESET 3: High-Traffic Production (Sampling, Async, Privacy)
# ------------------------------------------------------------------------------
# GLOBALLOG_DATABASE_ENABLED=true
# GLOBALLOG_DATABASE_MIN_LEVEL=warning
# GLOBALLOG_ASYNC_ENABLED=true
# GLOBALLOG_SAMPLING_ENABLED=true
# GLOBALLOG_SAMPLING_RATE=0.1
# GLOBALLOG_REDACT_PII=true
# GLOBALLOG_ANONYMIZE_IP=true
# GLOBALLOG_BATCH_ENABLED=true
# GLOBALLOG_CIRCUIT_BREAKER_ENABLED=true

# ------------------------------------------------------------------------------
# PRESET 4: Testing (Database, All logs, No sampling)
# ------------------------------------------------------------------------------
# GLOBALLOG_DATABASE_ENABLED=true
# GLOBALLOG_DATABASE_MIN_LEVEL=debug
# GLOBALLOG_REDACT_PII=true
# GLOBALLOG_SAMPLING_ENABLED=false
# GLOBALLOG_BATCH_ENABLED=true

# ------------------------------------------------------------------------------
# PRESET 5: GDPR Strict Compliance
# ------------------------------------------------------------------------------
# GLOBALLOG_REDACT_PII=true
# GLOBALLOG_LOG_USER_ID=false
# GLOBALLOG_LOG_IP_ADDRESS=false
# GLOBALLOG_LOG_USER_AGENT=false
# GLOBALLOG_ANONYMIZE_IP=true
# GLOBALLOG_DATABASE_INCLUDE_BINDINGS=false

# ==============================================================================
# Quick Start
# ==============================================================================
#
# 1. Copy this file to your application's .env:
#    cp vendor/gopimosali/global-logger/.env.example .env.globallogger
#
# 2. Add the variables you need to your .env file
#
# 3. For file-based logging (default):
#    - No additional setup required!
#    - Logs will be in storage/logs/globallogger.log
#
# 4. For database logging:
#    php artisan migrate
#    GLOBALLOG_DATABASE_ENABLED=true
#
# 5. Test with example logs:
#    php artisan globallogger:generate-examples --count=100
#
# 6. View logs:
#    tail -f storage/logs/globallogger.log
#    # or
#    SELECT * FROM global_logs ORDER BY created_at DESC LIMIT 100;
#
# ==============================================================================

# ==============================================================================
# Troubleshooting
# ==============================================================================
#
# Problem: No logs appearing
# Solution: php artisan config:clear && php artisan cache:clear
#
# Problem: PII not being redacted
# Solution: Verify GLOBALLOG_REDACT_PII=true and config:clear
#
# Problem: Database logs not working
# Solution: Check GLOBALLOG_DATABASE_ENABLED=true and migration ran
#
# Problem: Too many logs
# Solution: Enable sampling (GLOBALLOG_SAMPLING_ENABLED=true)
#           Or increase min level (GLOBALLOG_DATABASE_MIN_LEVEL=warning)
#
# Problem: Performance issues
# Solution: Enable batch logging (GLOBALLOG_BATCH_ENABLED=true)
#           Enable async logging (GLOBALLOG_ASYNC_ENABLED=true)
#           Enable sampling (GLOBALLOG_SAMPLING_ENABLED=true)
#
# ==============================================================================
