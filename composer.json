{
    "name": "gopimosali/global-logger",
    "description": "Universal Laravel logging with automatic request tracking, multi-provider support (AWS CloudWatch/X-Ray, Datadog, Oracle Cloud, Database, Files), and optional performance tracing",
    "keywords": [
        "laravel",
        "logging",
        "cloudwatch",
        "datadog",
        "oracle",
        "xray",
        "tracing",
        "monitoring",
        "apm"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gopi Mosali",
            "email": "gopimosali@example.com",
            "homepage": "https://github.com/gopimosali",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/gopimosali/global-logger",
    "support": {
        "issues": "https://github.com/gopimosali/global-logger/issues",
        "source": "https://github.com/gopimosali/global-logger",
        "docs": "https://github.com/gopimosali/global-logger#readme"
    },
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/log": "^10.0|^11.0|^12.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.50",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for AWS CloudWatch and X-Ray provider (^3.0)",
        "datadog/php-datadogstatsd": "Required for Datadog provider (^1.6)",
        "oci8/oci8": "Required for Oracle Cloud Logging provider (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "Gopimosali\\GlobalLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gopimosali\\GlobalLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gopimosali\\GlobalLogger\\GlobalLoggerServiceProvider"
            ],
            "aliases": {
                "GlobalLogger": "Gopimosali\\GlobalLogger\\Facades\\GlobalLogger"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage-html --coverage-text",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "format-check": "vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "quality": [
            "@format-check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run tests with coverage report",
        "analyse": "Run PHPStan static analysis",
        "format": "Fix code style with PHP CS Fixer",
        "format-check": "Check code style without fixing",
        "quality": "Run all quality checks (format, analyse, test)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
